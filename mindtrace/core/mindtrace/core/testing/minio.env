# Test-stack MinIO ports. This file is the single source of truth.
# Consumed by:
#   - tests/docker-compose.yml (interpolation via --env-file)
#   - scripts/docker_up.sh / scripts/run_tests.sh
#   - mindtrace.core.testing.local_services (Python)
#
# Host 19000/19001 avoid Prometheus node_exporter's default API port 9100.
# Inside the container MinIO still listens on its defaults (9000/9001).

MINIO_HOST=localhost
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_CONTAINER_API_PORT=9000
MINIO_CONTAINER_CONSOLE_PORT=9001
